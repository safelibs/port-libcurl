#! /usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
UPSTREAM_VERSION := $(shell printf '%s\n' '$(DEB_VERSION_UPSTREAM)' | sed 's/[+~].*//')
PACKAGE_ROOT := $(CURDIR)
PACKAGE_BUILD_ROOT := $(PACKAGE_ROOT)/target/package
PACKAGE_CARGO_HOME := $(PACKAGE_BUILD_ROOT)/cargo-home
PACKAGE_CARGO_TARGET_ROOT := $(PACKAGE_BUILD_ROOT)/cargo-target
PACKAGE_CARGO_FLAGS := --locked --offline
PACKAGE_COMPAT_ROOT := $(PACKAGE_ROOT)/.compat/package

PACKAGE_COMPAT_ENV = \
	CARGO_HOME="$(PACKAGE_CARGO_HOME)" \
	CARGO_NET_OFFLINE=true \
	SAFELIBS_COMPAT_CARGO_FLAGS="$(PACKAGE_CARGO_FLAGS)" \
	SAFELIBS_COMPAT_CARGO_LOCKED_OFFLINE=1 \
	SAFELIBS_COMPAT_CARGO_PROFILE=release \
	SAFELIBS_COMPAT_CARGO_TARGET_ROOT="$(PACKAGE_CARGO_TARGET_ROOT)" \
	SAFELIBS_COMPAT_ROOT="$(PACKAGE_COMPAT_ROOT)"

ifneq (,$(filter pkg.curl.openssl-only,$(DEB_BUILD_PROFILES)))
	DEB_BUILD_PROFILES += pkg.curl.no-gnutls
endif
ifneq (,$(filter pkg.curl.gnutls-only,$(DEB_BUILD_PROFILES)))
	DEB_BUILD_PROFILES += pkg.curl.no-openssl
endif

%:
	dh $@ --buildsystem=none

override_dh_auto_configure:
	:

override_dh_auto_build:
ifeq ($(filter pkg.curl.no-openssl,$(DEB_BUILD_PROFILES)),)
	$(PACKAGE_COMPAT_ENV) bash scripts/build-compat-consumers.sh --flavor openssl --target src:curl
endif
ifeq ($(filter pkg.curl.no-gnutls,$(DEB_BUILD_PROFILES)),)
	$(PACKAGE_COMPAT_ENV) bash scripts/build-compat-consumers.sh --flavor gnutls --target src:curl
endif

override_dh_auto_test:
ifeq ($(filter nocheck,$(DEB_BUILD_PROFILES)),)
ifeq ($(filter pkg.curl.no-openssl,$(DEB_BUILD_PROFILES)),)
	$(PACKAGE_COMPAT_ENV) bash scripts/run-curl-tool-smoke.sh --implementation compat --flavor openssl --build-state "$(PACKAGE_COMPAT_ROOT)/openssl/build-state.json"
endif
ifeq ($(filter pkg.curl.no-gnutls,$(DEB_BUILD_PROFILES)),)
	$(PACKAGE_COMPAT_ENV) bash scripts/run-curl-tool-smoke.sh --implementation compat --flavor gnutls --build-state "$(PACKAGE_COMPAT_ROOT)/gnutls/build-state.json"
endif
endif

override_dh_auto_install:
	rm -rf debian/tmp debian/tmp-gnutls
	install -d debian/tmp/usr/bin debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig debian/tmp/usr/include/$(DEB_HOST_MULTIARCH) debian/tmp/usr/share/aclocal
	install -d debian/tmp-gnutls/usr/bin debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig debian/tmp-gnutls/usr/include/$(DEB_HOST_MULTIARCH) debian/tmp-gnutls/usr/share/aclocal
	cp -a include/curl debian/tmp/usr/include/$(DEB_HOST_MULTIARCH)/
	cp -a include/curl debian/tmp-gnutls/usr/include/$(DEB_HOST_MULTIARCH)/
	install -m 0755 "$(PACKAGE_COMPAT_ROOT)/openssl/stage/lib/libcurl.so.4" debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl.so.4.8.0
	ln -s libcurl.so.4.8.0 debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl.so.4
	ln -s libcurl.so.4.8.0 debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl.so
	install -m 0755 "$(PACKAGE_COMPAT_ROOT)/openssl/stage/lib/libcurl-reference-openssl.so.4" debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-reference-openssl.so.4
	install -m 0755 "$(PACKAGE_COMPAT_ROOT)/openssl/worktree/src/curl" debian/tmp/usr/bin/curl
	install -m 0644 "$(PACKAGE_CARGO_TARGET_ROOT)/openssl/release/libport_libcurl_safe.a" debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl.a
	install -m 0755 "$(PACKAGE_COMPAT_ROOT)/gnutls/stage/lib/libcurl-gnutls.so.4" debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-gnutls.so.4.8.0
	ln -s libcurl-gnutls.so.4.8.0 debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-gnutls.so.4
	ln -s libcurl-gnutls.so.4.8.0 debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-gnutls.so
	install -m 0755 "$(PACKAGE_COMPAT_ROOT)/gnutls/stage/lib/libcurl-reference-gnutls.so.4" debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-reference-gnutls.so.4
	install -m 0644 "$(PACKAGE_CARGO_TARGET_ROOT)/gnutls/release/libport_libcurl_safe.a" debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl-gnutls.a
	sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' -e 's/@CURLVERSION@/$(UPSTREAM_VERSION)/g' libcurl.pc >debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig/libcurl.pc
	sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' -e 's/@CURLVERSION@/$(UPSTREAM_VERSION)/g' libcurl.pc >debian/tmp-gnutls/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig/libcurl.pc
	sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' -e 's/@CURLVERSION@/$(UPSTREAM_VERSION)/g' -e 's/@SSL_BACKENDS@/OpenSSL/g' -e 's/@CONFIGURE_SSL_ARG@/--with-openssl/g' curl-config >debian/tmp/usr/bin/curl-config
	sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' -e 's/@CURLVERSION@/$(UPSTREAM_VERSION)/g' -e 's/@SSL_BACKENDS@/GnuTLS/g' -e 's/@CONFIGURE_SSL_ARG@/--with-gnutls/g' curl-config >debian/tmp-gnutls/usr/bin/curl-config
	chmod 0755 debian/tmp/usr/bin/curl-config debian/tmp-gnutls/usr/bin/curl-config
	install -m 0644 docs/libcurl/libcurl.m4 debian/tmp/usr/share/aclocal/libcurl.m4
	install -m 0644 docs/libcurl/libcurl.m4 debian/tmp-gnutls/usr/share/aclocal/libcurl.m4

override_dh_install:
	dh_install -pcurl -plibcurl4t64 -plibcurl4-openssl-dev -plibcurl4-doc --sourcedir=debian/tmp
	dh_install -plibcurl3t64-gnutls -plibcurl4-gnutls-dev --sourcedir=debian/tmp-gnutls

override_dh_compress:
	dh_compress -X.pdf

override_dh_makeshlibs:
	dh_makeshlibs -Xlibcurl-reference -- -c0

override_dh_clean:
	dh_clean -XCargo.toml.orig

override_dh_auto_clean:
	rm -rf debian/tmp debian/tmp-gnutls "$(PACKAGE_BUILD_ROOT)" "$(PACKAGE_COMPAT_ROOT)" .reference
	dh_auto_clean --buildsystem=none
